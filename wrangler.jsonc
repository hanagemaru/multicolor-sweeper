{
  // Cloudflare Workers Static Assets + ranking API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multicolor-sweeper",
  "main": "./src/server/worker.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    // APIだけWorkerを先に実行し、通常のゲーム資産はStatic Assetsから配る。
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multicolor-sweeper-ranking",
      "database_id": "bae4d381-409e-44e2-b76f-953b397f2be1",
      "preview_database_id": "0d70c1ca-2fa3-4f1d-925a-a12f993f200a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
